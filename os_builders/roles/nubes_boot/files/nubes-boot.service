[Unit]
Description=Set hostname and start ssh keys scripts

Wants=network-online.target
After=network-online.target systemd-hostnamed.service
Before=sshd.service

[Service]
Type=oneshot
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/sbin/nubes-boot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
